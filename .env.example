# ============================================================
# SFLS 运动会系统 - 环境配置示例
# 复制为 .env 后按需修改。切勿把真实 .env 提交到仓库。
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=sfls_root_pwd_change_me
MYSQL_DATABASE=sfls_meeting
MYSQL_USER=sfls
MYSQL_PASSWORD=sfls_pwd_change_me
# 容器内部端口固定 3306；如需在宿主机调试可映射，见 docker-compose
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- Backend ----
# JWT 签名密钥，生产务必替换为随机长字符串
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_MINUTES=720

# 唯一管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# DeepSeek API（竞赛日程 AI 生成用，可后续在系统内配置覆盖）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 端口 ----
# 对外统一暴露端口（前端 + 反代后端）
# 注意：宿主机 8686 已被其它容器占用，本项目默认改用 8687
APP_PORT=8687
